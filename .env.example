# Shelfwise settings (environment variables or this file as .env). Never commit a real key.

# ---- models: fake (offline, default) | openrouter | openai | compat
SHELFWISE_LLM_PROVIDER=fake
# OPENROUTER_API_KEY=
# SHELFWISE_VISION_MODEL=dots-studio/dots-3-note-preview:free
# SHELFWISE_VISION_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# SHELFWISE_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SHELFWISE_TEXT_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
# SHELFWISE_LLM_REASONING_EFFORT=low          # vision and copy; "off" disables reasoning
# SHELFWISE_TRANSLATE_REASONING_EFFORT=off    # translation needs none

# ---- the free-only guard (on by default): refuses OpenRouter/compat ids without ":free", :online, plugins,
# and answers served by a paid model. Paid models need this explicit opt-in:
# SHELFWISE_ALLOW_PAID_MODELS=false
# Any OpenAI-compatible endpoint (a gateway, a paid provider) once paid models are allowed:
# SHELFWISE_LLM_BASE_URL=https://your-gateway.example/v1
# SHELFWISE_LLM_API_KEY=
# SHELFWISE_LLM_SEND_TEMPERATURE=true

# ---- budget and politeness for real APIs
# SHELFWISE_LLM_MAX_CALLS=3000                 # hard cap per ledger file, retries included
# SHELFWISE_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3
# SHELFWISE_LLM_MAX_RETRIES=4
# SHELFWISE_LLM_CACHE=true
# SHELFWISE_LLM_CACHE_DIR=.cache/llm
# SHELFWISE_LLM_LEDGER=results/calls.jsonl     # empty = no ledger
# SHELFWISE_LLM_CONCURRENCY=2                  # products enriched in parallel
# SHELFWISE_COPY_RETRIES=1                     # corrective rounds when a listing fails validation

# ---- store and storage
# SHELFWISE_STORE_CONFIG=configs/store.yaml
# SHELFWISE_STYLE_GUIDE=configs/style_guide.yaml
# SHELFWISE_DATABASE=.cache/shelfwise.db
# SHELFWISE_WORKSPACE_DIR=.cache/workspace
# SHELFWISE_SEED_DEMO=true
# SHELFWISE_CORS_ORIGINS=http://localhost:3000

# ---- the mock stores (mounted in the API under /mock; no real store, no account)
# SHELFWISE_SHOPIFY_URL=http://127.0.0.1:8000/mock/shopify
# SHELFWISE_SHOPIFY_API_VERSION=2026-07
# SHELFWISE_WOOCOMMERCE_URL=http://127.0.0.1:8000/mock/woocommerce
